# ============================================================================
# PayBench environment — copy this file to `.env` and fill in what you need.
#
#   cp .env.example .env
#
# `.env` is gitignored (your keys never leave this machine) and is AUTO-LOADED
# by the CLI (`python -m app.cli ...`) and the dashboard server at startup —
# no `export`, no `source`, no shell setup. Rules:
#
#   - Leave values empty for providers you don't use; those are skipped with a
#     clear message. Don't paste placeholder text as a value — an empty value
#     means "unset", anything else is treated as a real key.
#   - A shell-exported variable always overrides this file (handy for one-offs).
#   - Set PAYBENCH_SKIP_DOTENV=1 to disable auto-loading entirely.
#
# Only fill in what the commands you run actually need:
#   live evals  -> the provider key(s) below
#   publish     -> SUPABASE_SERVICE_KEY
#   dry runs / tests / survey -> nothing at all
# ============================================================================


# ----------------------------------------------------------------------------
# OpenAI  (eval --models openai)
#
# Get a key: https://platform.openai.com/api-keys  ("Create new secret key",
# starts with `sk-`). Billing must be enabled on the account.
#
# Model: optional. Unset = `gpt-5.4-nano`, the cheapest current OpenAI model
# ($0.20/$1.25 per 1M in/out tokens). List ids your key can use:
#   python -m app.cli models --provider openai
# ----------------------------------------------------------------------------
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.4-nano
# OPENAI_REASONING_EFFORT=low   # none|low|medium|high|xhigh (gpt-5.x models)


# ----------------------------------------------------------------------------
# Anthropic / Claude  (eval --models anthropic)
#
# Get a key: https://platform.claude.com -> Settings -> API Keys  (starts with
# `sk-ant-`).
#
# Model: optional. Unset = `claude-haiku-4-5`, the cheapest current Claude
# ($1.00/$5.00 per 1M in/out tokens). List ids:
#   python -m app.cli models --provider anthropic
# ----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5


# ----------------------------------------------------------------------------
# Google Gemini  (eval --models gemini)
#
# Get a key: https://aistudio.google.com/apikey  ("Create API key").
# GOOGLE_API_KEY is accepted as a fallback name for the same value.
#
# Model: optional. Unset = `gemini-2.5-flash-lite`, the cheapest current Gemini
# ($0.10/$0.40 per 1M in/out tokens; retires 2026-10-16 — successor is
# gemini-3.1-flash-lite). List ids:
#   python -m app.cli models --provider gemini
# ----------------------------------------------------------------------------
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash-lite


# ----------------------------------------------------------------------------
# Kimi / Moonshot AI  (eval --models kimi)
#
# Get a key: https://platform.kimi.ai -> API Keys. MOONSHOT_API_KEY is
# accepted as a fallback name for the same value.
#
# Model: optional. Unset = `kimi-k2.6`, the cheapest current non-retiring Kimi
# model ($0.95/$4.00 per 1M in/out tokens). Also available: `kimi-k3`
# (flagship, 1M context), `kimi-k2.7-code` / `kimi-k2.7-code-highspeed`
# (coding), `kimi-k2.5` (cheaper but being phased out for new users). List
# ids:
#   python -m app.cli models --provider kimi
# ----------------------------------------------------------------------------
KIMI_API_KEY=
# KIMI_MODEL=kimi-k2.6


# ----------------------------------------------------------------------------
# Inkling / Thinking Machines Lab  (eval --models inkling)
#
# Inkling is a single open-weight model (not a hosted family), served
# OpenAI-compatible by several third-party inference providers. Defaults to
# Together AI's slug/endpoint; TOGETHER_API_KEY is accepted as a fallback key
# name. Get a key: https://api.together.ai/settings/api-keys.
#
# To use a different host (Fireworks, Modal, Databricks, Baseten) instead,
# set INKLING_BASE_URL and INKLING_MODEL to that host's endpoint/slug.
# ----------------------------------------------------------------------------
INKLING_API_KEY=
# INKLING_MODEL=thinkingmachines/Inkling
# INKLING_BASE_URL=https://api.together.xyz/v1


# ----------------------------------------------------------------------------
# xAI Grok  (eval --models grok)
#
# Get a key: https://console.x.ai -> API Keys (starts with `xai-`).
# GROK_API_KEY is accepted as a fallback name for XAI_API_KEY.
#
# Model: optional. Unset = `grok-4.1-fast` (cheap, high-throughput, 2M ctx).
# Also: grok-4.3 (hard reasoning), grok-4-heavy. List ids:
#   python -m app.cli models --provider grok
# ----------------------------------------------------------------------------
XAI_API_KEY=
# GROK_MODEL=grok-4.1-fast


# ----------------------------------------------------------------------------
# DeepSeek  (eval --models deepseek)
#
# Get a key: https://platform.deepseek.com -> API keys.
#
# Model: optional. Unset = `deepseek-v4-flash` ($0.14/$0.28 per 1M in/out).
# Also: deepseek-v4-pro. Thinking mode toggles in-request, not by model id.
# List ids:  python -m app.cli models --provider deepseek
# ----------------------------------------------------------------------------
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-v4-flash


# ----------------------------------------------------------------------------
# Mistral  (eval --models mistral)
#
# Get a key: https://console.mistral.ai -> API Keys.
#
# Model: optional. Unset = `mistral-small-latest` (cheap). Also:
# mistral-large-latest, magistral-medium-latest (reasoning). List ids:
#   python -m app.cli models --provider mistral
# ----------------------------------------------------------------------------
MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-small-latest


# ----------------------------------------------------------------------------
# Qwen / Alibaba Model Studio  (eval --models qwen)
#
# Get a key: https://bailian.console.alibabacloud.com (DashScope). QWEN_API_KEY
# is accepted as a fallback for DASHSCOPE_API_KEY. Defaults to the
# international host; set QWEN_BASE_URL for a regional one (dashscope-us, etc).
#
# Model: optional. Unset = `qwen-flash` (cheap). Also: qwen-plus, qwen3-max.
# (Qwen's model list isn't dependable across regions, so set QWEN_MODEL
# directly rather than relying on `models --provider qwen`.)
# ----------------------------------------------------------------------------
DASHSCOPE_API_KEY=
# QWEN_MODEL=qwen-flash
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1


# ----------------------------------------------------------------------------
# OpenRouter  (eval --models openrouter)   — OPTIONAL convenience gateway
#
# A gateway: one key + one credit balance reaches 300+ models from 60+
# providers via namespaced slugs. Get a key: https://openrouter.ai/keys
# (starts with `sk-or-`).
#
# NOTE ON COST: OpenRouter adds a small routing markup on top of each
# vendor's price. To pay each vendor DIRECTLY at native prices (no markup),
# leave this blank and fill in the per-provider keys above (OPENAI_API_KEY,
# XAI_API_KEY, DEEPSEEK_API_KEY, MISTRAL_API_KEY, DASHSCOPE_API_KEY, ...)
# instead — each provider already prefers its own native key. OpenRouter is
# only worth it when you'd rather fund one balance than sign up with every
# vendor separately.
#
# Model: REQUIRED when used (no single default). Use a full slug, e.g.
# `x-ai/grok-4.1-fast`, `deepseek/deepseek-v4-pro`, `qwen/qwen3-max`. List:
#   python -m app.cli models --provider openrouter
# ----------------------------------------------------------------------------
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=x-ai/grok-4.1-fast


# ----------------------------------------------------------------------------
# Open-weights models  (eval --models openweights)
#
# Any OpenAI-compatible local server (vLLM, llama.cpp, TGI). Both values are
# required for this provider; there is no default.
# ----------------------------------------------------------------------------
# OPENWEIGHTS_BASE_URL=http://127.0.0.1:8001
# OPENWEIGHTS_MODEL=
# OPENWEIGHTS_API_KEY=local


# ----------------------------------------------------------------------------
# Publishing results to the public site  (python -m app.cli publish)
#
# Get the key: https://supabase.com/dashboard -> your project -> Project
# Settings -> API -> "service_role" key.
#
# SECRET: this key bypasses row-level security. Never commit it and never put
# it in static/config.js (the site uses the separate public "publishable" key).
# It is the ONLY value publish needs — SUPABASE_URL defaults to the public
# project baked into app/supabase_publish.py.
# ----------------------------------------------------------------------------
SUPABASE_SERVICE_KEY=
# SUPABASE_URL=https://tethtzycfdplyzvrtknh.supabase.co
# SUPABASE_BENCHMARK_TABLE=benchmark_runs
# Human-baseline sessions (`publish-human-baseline`) use the same key:
# SUPABASE_HUMAN_BASELINE_TABLE=human_baseline_sessions


# ----------------------------------------------------------------------------
# Harness knobs (rarely needed)
# ----------------------------------------------------------------------------
# SCENARIO_SET=v2_250_scenarios     # scenario set stem, or:
# SCENARIO_SET_PATH=data/scenario_sets/v2_250_scenarios.md
# RUN_STORAGE_DIR=runtime/runs      # where run JSON files are written
# RUN_LIVE_OPENAI_EVAL=1            # enable tests/test_live_openai.py
# PAYBENCH_SKIP_DOTENV=1            # disable .env auto-loading
