# Copy to .env (gitignored) and fill in. Only needed for the commands you run.

# --- Model providers (live evals) ---
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.5
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=

# --- Publishing results to the public site (`python -m app.cli publish`) ---
# Service-role key from Supabase > Project Settings > API. SECRET: never commit
# this and never put it in static/config.js — it bypasses row-level security.
# This is the ONLY value publish needs.
SUPABASE_SERVICE_KEY=
# Optional: only set SUPABASE_URL to publish to a different project. It defaults
# to the public project URL baked into app/supabase_publish.py (DEFAULT_URL).
# SUPABASE_URL=https://tethtzycfdplyzvrtknh.supabase.co
# SUPABASE_BENCHMARK_TABLE=benchmark_runs
# Human-baseline sessions (`python -m app.cli publish-human-baseline`) use the
# same SUPABASE_SERVICE_KEY and write to this table.
# SUPABASE_HUMAN_BASELINE_TABLE=human_baseline_sessions
