# PayBench environment — cp .env.example .env, fill in what you need.
# .env is gitignored and auto-loaded by the CLI/dashboard, no export/source needed.
# Leave a key blank to skip that provider. Shell-exported vars override this file.
# Nothing needed at all for dry runs / tests / survey. List a provider's model ids:
#   python -m app.cli models --provider <name>

# OpenAI          https://platform.openai.com/api-keys        | default gpt-5.4-nano ($0.20/$1.25/1M)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.4-nano
# OPENAI_REASONING_EFFORT=low   # none|low|medium|high|xhigh

# Anthropic       https://platform.claude.com (Settings > API Keys) | default claude-haiku-4-5 ($1.00/$5.00/1M)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5

# Gemini          https://aistudio.google.com/apikey           | default gemini-3.1-flash-lite ($0.25/$1.50/1M)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-flash-lite

# Kimi/Moonshot   https://platform.kimi.ai                     | default kimi-k2.6 ($0.95/$4.00/1M)
KIMI_API_KEY=
# KIMI_MODEL=kimi-k2.6

# Inkling (open-weight, via Together AI by default) https://api.together.ai/settings/api-keys
INKLING_API_KEY=
# INKLING_MODEL=thinkingmachines/Inkling
# INKLING_BASE_URL=https://api.together.xyz/v1   # swap host: Fireworks/Modal/Databricks/Baseten

# xAI Grok        https://console.x.ai                         | default grok-4.20-0309-non-reasoning ($1.25/$2.50/1M)
XAI_API_KEY=
# GROK_MODEL=grok-4.20-0309-non-reasoning

# DeepSeek        https://platform.deepseek.com                | default deepseek-v4-flash ($0.14/$0.28/1M) — cheapest
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-v4-flash

# Mistral         https://console.mistral.ai                   | default mistral-small-latest
MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-small-latest

# Qwen/DashScope  https://bailian.console.alibabacloud.com     | default qwen-flash
DASHSCOPE_API_KEY=
# QWEN_MODEL=qwen-flash
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# OpenRouter (optional gateway, adds a markup — prefer native keys above) https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=x-ai/grok-4.3   # required, no default; full vendor/model slug

# Open-weights (any OpenAI-compatible local server: vLLM/llama.cpp/TGI) — both required, no default
# OPENWEIGHTS_BASE_URL=http://127.0.0.1:8001
# OPENWEIGHTS_MODEL=
# OPENWEIGHTS_API_KEY=local

# Publish to the public site (python -m app.cli publish) — Supabase dashboard > Project Settings > API > service_role
# SECRET: bypasses row-level security, never commit it, never put it in static/config.js
SUPABASE_SERVICE_KEY=
# SUPABASE_URL=https://tethtzycfdplyzvrtknh.supabase.co
# SUPABASE_BENCHMARK_TABLE=benchmark_runs

# Harness knobs (rarely needed)
# SCENARIO_SET=v2_250_scenarios
# SCENARIO_SET_PATH=data/scenario_sets/v2_250_scenarios.md
# RUN_STORAGE_DIR=runtime/runs
# RUN_LIVE_OPENAI_EVAL=1
# PAYBENCH_SKIP_DOTENV=1
