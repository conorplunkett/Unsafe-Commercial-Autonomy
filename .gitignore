# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.venv
/.pnp
.pnp.js

# testing
/coverage
__pycache__/
*.py[cod]

# next.js
/.next/
/out/

# production
/build
/runtime

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# vercel
.vercel

# supabase CLI local link state
supabase/.temp/

# claude code MCP config (personal tooling, not project code)
.mcp.json
.claude/launch.json

# typescript
*.tsbuildinfo
next-env.d.ts

# Raw survey exports contain PII (respondent names, emails) — never commit
# them. Keep any local copy under data/survey/raw/ (ignored) and commit only
# the aggregates produced by scripts/analyze_phase1_survey.py.
data/survey/raw/
